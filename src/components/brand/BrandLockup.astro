---
interface Props {
  size?: "header" | "hero" | "footer";
  href?: string;
  /** Porcelain (default) or Ink surfaces — picks outlined lockup polarity. */
  surface?: "porcelain" | "ink";
}

const { size = "header", href, surface = "porcelain" } = Astro.props;

type LockupGeometry = {
  height: number;
  width: number;
  src: string;
};

function lockupGeometry(
  value: "header" | "hero" | "footer",
  surfaceValue: "porcelain" | "ink",
): LockupGeometry {
  // Brand Kit v5 compact lockup (sail, wordmark, descriptor; the ring is
  // dropped below 40 px). viewBox 715×118 → aspect ~6.06.
  const onInk = surfaceValue === "ink" || value === "footer";
  const src = onInk
    ? "/brand/blueskyz/v5/logos/lockup-compact-labs-night.svg"
    : "/brand/blueskyz/v5/logos/lockup-compact-labs-paper.svg";

  switch (value) {
    case "header":
      return { height: 34, width: 206, src };
    case "hero":
      return { height: 50, width: 303, src };
    case "footer":
      return { height: 34, width: 206, src };
    default: {
      const _exhaustive: never = value;
      return _exhaustive;
    }
  }
}

const geometry = lockupGeometry(size, surface);
const adaptive = surface === "porcelain" && size !== "footer";
const reverse = lockupGeometry(size, "ink");
const Tag = href ? "a" : "p";
const className = [
  "brand-lockup inline-flex min-h-11 items-center no-underline",
  adaptive && "brand-lockup--adaptive",
]
  .filter(Boolean)
  .join(" ");
---

<Tag href={href} class={className}>
  <img
    src={geometry.src}
    alt="BlueSkyz Labs logo"
    width={geometry.width}
    height={geometry.height}
    class="brand-lockup__img brand-lockup__img--light block h-auto max-w-full"
    decoding="async"
  />
  {adaptive ? (
    <img
      src={reverse.src}
      alt="BlueSkyz Labs logo"
      width={reverse.width}
      height={reverse.height}
      class="brand-lockup__img brand-lockup__img--dark h-auto max-w-full"
      decoding="async"
    />
  ) : null}
</Tag>
