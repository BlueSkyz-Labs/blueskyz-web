---
import BlueSkyzIcon from "@/components/icon/BlueSkyzIcon.astro";
import Container from "@/components/layout/Container.astro";
import ProductStatus from "@/components/product/ProductStatus.astro";
import { EMPTY_STATE_COPY } from "@/data/empty-state-copy";
import { SITE, labelFor, SHARED_LABELS, type Language } from "@/data/site";
import { getPublicProducts } from "@/lib/products";
import { productPageCopy } from "@/components/product/product-page-copy";
import { getEntry } from "astro:content";

/**
 * Experience v6 S8 — About, composed only from existing authored data:
 * registry products and the "What you can check" block (v8
 * abt-5; two bound claims linked to their pages).
 *
 * Owner-confirmed entity facts (audit E-26 resolved 2026-10-07, #523): the
 * `pages` collection `{lang}-about` entry supplies founder name/title and
 * location, rendered below as the entity identity block. The confirmed
 * operating year is shown once from SITE.operatingSinceYear above.
 * Absent fields are still omitted, never padded. The founder feature uses
 * decorative brand artwork rather than implying an unverified portrait.
 *
 * UI upgrade F12 (presentation only): products render as hairline cards whose
 * whole surface is the link target; each checkable claim is a full-width row
 * with a trailing arrow, so the link affordance no longer depends on an
 * underlined sentence. Product and claim copy remain authored by their sources.
 *
 * v12 S2: each card says what the product does for the visitor, with the
 * same presentation one-liner as its profile page (`productPageCopy`, which
 * falls back to the registry `shortDescription`), instead of the registry's
 * internal phrasing ("Vietnam-first", "trusted history").
 */
interface Props {
  lang: Language;
  /**
   * Owner 2026-11-10: the page opens on a full-width ink band ("hero": page
   * title, mission, founder identity, operating year and the brand elevation)
   * and continues in the content column ("body": products and checks). The
   * facts and their sources are the same; only where they stand changed.
   */
  part: "hero" | "body";
  /** Page H1, required for the hero part. */
  title?: string;
}

interface AboutContent {
  heading?: unknown;
  intro?: unknown;
  founder_name?: unknown;
  founder_title?: unknown;
  location?: unknown;
}

const { lang, part, title } = Astro.props;
const products = (await getPublicProducts()).map((product) => ({
  slug: product.data.slug,
  name: product.data.name,
  description: productPageCopy(product.data, lang).oneLiner,
  publicLabel: product.data.publicLabel,
}));

const aboutEntry = await getEntry("pages", `${lang}-about`);
const aboutContent = aboutEntry?.data.sections?.content as
  AboutContent | undefined;
const missionHeading =
  typeof aboutContent?.heading === "string" ? aboutContent.heading : null;
const missionIntro =
  typeof aboutContent?.intro === "string" ? aboutContent.intro : null;
const founderName =
  typeof aboutContent?.founder_name === "string"
    ? aboutContent.founder_name
    : null;
const founderTitle =
  typeof aboutContent?.founder_title === "string"
    ? aboutContent.founder_title
    : null;
const founderLocation =
  typeof aboutContent?.location === "string" ? aboutContent.location : null;
---

{part === "hero" ? (
  <section class="about-hero" data-about-hero>
    <Container class="about-hero__inner">
      <div class="about-hero__copy">
        <h1 class="about-hero__title type-d1 text-balance">{title}</h1>
        {missionHeading && missionIntro && (
          <section
            class="about-mission"
            aria-labelledby="about-mission-title"
            data-about-mission
          >
            <h2 id="about-mission-title" class="about-mission__title">
              {missionHeading}
            </h2>
            <p class="about-mission__copy text-pretty">{missionIntro}</p>
          </section>
        )}
        <div class="about-hero__facts">
          {founderName && founderLocation && (
            <section
              class="about-founder"
              aria-labelledby="about-founder"
              data-about-founder
            >
              {founderTitle && (
                <p class="about-founder__title">{founderTitle}</p>
              )}
              <h2 id="about-founder" class="about-founder__name">
                {founderName}
              </h2>
              <p class="about-founder__meta text-pretty">{founderLocation}</p>
            </section>
          )}
          <p class="about-founded" data-organization-founding-year>
            {labelFor(SHARED_LABELS.operatingSince, lang)}{" "}
            {/* dateline-exempt: year */}
            <time datetime={String(SITE.operatingSinceYear)}>
              {SITE.operatingSinceYear}
            </time>
          </p>
        </div>
      </div>
      <div class="about-founder__art" aria-hidden="true">
        <img
          src="/images/about/founder-elevation.webp"
          alt=""
          width="960"
          height="1200"
          decoding="async"
        />
      </div>
    </Container>
  </section>
) : (
  <Fragment>
    <div class="about-grid" data-about-composition>
      {products.length > 0 ? (
        <section aria-labelledby="about-make">
          <h2 id="about-make" class="about-label">
            <span class="about-label__text">
              {labelFor(EMPTY_STATE_COPY.aboutWhatWeMake, lang)}
            </span>
          </h2>
          <ul class="about-products">
            {products.map((product) => (
              <li class="about-product" data-about-product>
                <a
                  href={`/${lang}/products/${product.slug}/`}
                  class="about-product__name"
                >
                  {product.name}
                  <BlueSkyzIcon
                    name="arrow-right"
                    class="about-arrow h-4 w-4 shrink-0"
                  />
                </a>
                <ProductStatus label={product.publicLabel} lang={lang} />
                <p class="about-product__desc text-pretty">
                  {product.description}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ) : null}
      <section aria-labelledby="about-check" data-about-check>
        <h2 id="about-check" class="about-label">
          <span class="about-label__text">
            {labelFor(EMPTY_STATE_COPY.aboutCheck, lang)}
          </span>
        </h2>
        <ul class="about-checks">
          <li data-claim-id="privacy-no-tracking-on-this-site">
            <a href={`/${lang}/privacy/`} class="about-check">
              <span class="text-pretty">
                {labelFor(EMPTY_STATE_COPY.aboutCheckNoCookies, lang)}
              </span>
              <BlueSkyzIcon
                name="arrow-right"
                class="about-arrow h-4 w-4 shrink-0"
              />
            </a>
          </li>
          <li data-claim-id="security-reporting-is-private">
            <a href={`/${lang}/security/`} class="about-check">
              <span class="text-pretty">
                {labelFor(EMPTY_STATE_COPY.aboutCheckSecurity, lang)}
              </span>
              <BlueSkyzIcon
                name="arrow-right"
                class="about-arrow h-4 w-4 shrink-0"
              />
            </a>
          </li>
        </ul>
        <a
          href={`/${lang}/verify/`}
          class="about-verify inline-flex items-center gap-2"
        >
          {labelFor(EMPTY_STATE_COPY.aboutCheckCta, lang)}
          <BlueSkyzIcon
            name="arrow-right"
            class="about-arrow h-4 w-4 shrink-0"
          />
        </a>
      </section>
    </div>
    {SITE.founderEmail ? (
      <p
        class="mt-8 text-sm text-[var(--text-secondary)]"
        data-public-email-role="founder"
      >
        {labelFor(SHARED_LABELS.strategicContact, lang)}{" "}
        <a
          href={`mailto:${SITE.founderEmail}`}
          class="font-semibold text-[var(--action-primary)] underline underline-offset-4 hover:no-underline"
        >
          {SITE.founderEmail}
        </a>
      </p>
    ) : null}
  </Fragment>
)}
<style>
  /* ---- Hero band: always ink, porcelain text in both themes ---- */
  .about-hero {
    position: relative;
    overflow: hidden;
    background: var(--brand-ink);
    color: var(--brand-porcelain);
    border-bottom: 1px solid color-mix(in srgb, white 8%, transparent);
  }
  .about-hero :global(.about-hero__inner) {
    display: grid;
    gap: 2.5rem;
    padding-block: 3.5rem 0;
  }
  .about-hero__copy {
    min-inline-size: 0;
  }
  .about-hero__title {
    margin: 0;
    color: var(--brand-porcelain);
  }
  .about-mission {
    max-width: 36rem;
    margin-block: 2rem 0;
  }
  .about-mission__title {
    margin: 0;
    font-size: var(--size-2);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow, 0.12em);
    color: color-mix(in srgb, var(--brand-cobalt) 65%, white);
  }
  :lang(vi) .about-mission__title {
    letter-spacing: 0.03em;
  }
  :lang(zh) .about-mission__title {
    letter-spacing: 0.02em;
  }
  .about-mission__copy {
    margin: 0.75rem 0 0;
    font-size: var(--size-5);
    line-height: 1.5;
    color: color-mix(in srgb, var(--brand-porcelain) 86%, transparent);
  }
  .about-hero__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1.5rem 3.5rem;
    max-width: 38rem;
    margin-block-start: 2.5rem;
    padding-block-start: 1.75rem;
    border-block-start: 1px solid color-mix(in srgb, white 16%, transparent);
  }
  .about-founder {
    min-inline-size: 0;
  }
  .about-founder__title {
    margin: 0 0 0.4rem;
    font-size: var(--size-1);
    font-weight: 600;
    line-height: var(--lh-1);
    letter-spacing: var(--tracking-eyebrow, 0.12em);
    color: color-mix(in srgb, var(--brand-cobalt) 65%, white);
  }
  .about-founder__name {
    margin: 0;
    font-size: var(--size-6);
    font-weight: 600;
    line-height: var(--lh-6);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    color: var(--brand-porcelain);
  }
  .about-founder__meta,
  .about-founded {
    margin: 0.4rem 0 0;
    font-size: var(--size-2);
    line-height: var(--lh-2);
    color: color-mix(in srgb, var(--brand-porcelain) 72%, transparent);
  }
  .about-founded {
    margin: 0;
  }
  .about-founder__art {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-inline: calc(var(--site-gutter) * -1);
  }
  .about-founder__art img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* Keep the sail tip and base inside the square crop (art spans ~5-83% of the height). */
    object-position: 50% 19%;
  }
  @media (min-width: 48rem) {
    .about-hero :global(.about-hero__inner) {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
      gap: 3rem;
      padding-block: 0;
    }
    .about-hero__copy {
      padding-block: 4.5rem;
    }
    /* Square and bounded; the left edge dissolves into the ink so the
       elevation reads as part of the band, not a framed picture. */
    .about-founder__art {
      aspect-ratio: 1 / 1;
      max-inline-size: 40rem;
      margin-inline: 0;
      justify-self: end;
      inline-size: 100%;
      mask-image: linear-gradient(to right, transparent, #000 32%);
    }
  }
  @media (forced-colors: active) {
    .about-founder__art {
      mask-image: none;
    }
  }
  .about-grid {
    display: grid;
    gap: 3rem;
    margin-block-start: 3rem;
  }
  @media (min-width: 48rem) {
    .about-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3.5rem;
    }
  }
  .about-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: var(--size-1);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow, 0.12em);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  /* Vietnamese: sentence case (cross-subset kerning, see .eyebrow). */
  :lang(vi) .about-label {
    text-transform: none;
    letter-spacing: var(--tracking-eyebrow, 0.03em);
  }
  /* One flex item for the words: the zh build wraps each word in .cjk-word,
     and as separate flex items they took the 0.75rem gap between them and
     could not wrap under 200% text. */
  .about-label__text {
    min-inline-size: 0;
  }
  .about-label::before {
    content: "";
    inline-size: 1.5rem;
    border-block-start: 1px solid var(--action-primary);
    flex: none;
  }
  :lang(vi) .about-label {
    letter-spacing: 0.06em;
  }
  :lang(zh) .about-label {
    letter-spacing: 0.04em;
  }
  .about-products,
  .about-checks {
    display: grid;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .about-products {
    gap: 1rem;
  }
  .about-product {
    position: relative;
    padding: 1.25rem 1.5rem 1.5rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    background: var(--surface-raised);
    transition: border-color 150ms var(--brand-ease-standard, ease);
  }
  .about-product:hover {
    border-color: var(--text-secondary);
  }
  .about-product__name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: var(--size-4);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    text-decoration: none;
  }
  /* The whole card is the target; the name stays the accessible link text. */
  .about-product__name::after {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: inherit;
  }
  .about-product [data-product-status] {
    position: relative;
    z-index: 1;
    margin-inline-start: 0.75rem;
    pointer-events: none;
    vertical-align: middle;
  }
  .about-product__name:focus-visible {
    outline: none;
  }
  .about-product__name:focus-visible::after {
    outline: 2px solid var(--brand-cobalt);
    outline-offset: 2px;
  }
  .about-product__desc {
    margin: 0;
    font-size: var(--size-2);
    line-height: 1.6;
    color: var(--text-secondary);
  }
  /* The icon is rendered by a child component, so it is styled through
     :global() under this component's scoped ancestors. */
  .about-grid :global(.about-arrow) {
    color: var(--action-primary);
    transition: translate 150ms var(--brand-ease-standard, ease);
  }
  .about-product:hover :global(.about-arrow),
  .about-check:hover :global(.about-arrow) {
    translate: 0.1875rem 0;
  }
  .about-checks {
    border-block-end: 1px solid var(--border-subtle);
  }
  .about-check {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding-block: 1rem;
    border-block-start: 1px solid var(--border-subtle);
    color: var(--text-primary);
    text-decoration: none;
  }
  .about-check:hover span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .about-verify {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-block-start: 0.75rem;
    font-size: var(--size-2);
    font-weight: 600;
    color: var(--action-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .about-verify:hover {
    text-decoration: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .about-product,
    .about-grid :global(.about-arrow) {
      transition: none;
    }
    .about-product:hover :global(.about-arrow),
    .about-check:hover :global(.about-arrow) {
      translate: none;
    }
  }
  @media (forced-colors: active) {
    .about-label::before,
    .about-founder,
    .about-founder__meta {
      border-color: CanvasText;
    }
    .about-founder__title {
      color: CanvasText;
    }
    .about-grid :global(.about-arrow) {
      color: LinkText;
    }
  }
</style>
