---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Container from "@/components/layout/Container.astro";
import { getHomeCloseActions } from "@/lib/journey";
import { SHARED_LABELS, labelFor, type Language } from "@/data/site";
import { getEntry } from "astro:content";

/**
 * Home close (Owner 2026-11-10): the page ends on a statement, not a strip.
 *
 * The statement is copy already authored for the home in
 * `pages/<lang>/index.yaml`: the hero's supporting line as the heading and the
 * house intro under it; nothing is written here. (The "One house" heading
 * itself stays off the home, as decided in Experience v6.) The artwork is the decorative brand elevation already used on
 * About. The three next steps are the same links as before, inside the same
 * navigation landmark. Without the authored line the band falls back to the
 * plain next-steps row.
 */
interface Props {
  lang: Language;
}
interface HomeSections {
  hero?: { supporting?: unknown };
  onewhouse?: { intro?: unknown };
}
const { lang } = Astro.props;
const navLabel = labelFor(SHARED_LABELS.nextSteps, lang);
const actions = getHomeCloseActions(lang);

const home = await getEntry("pages", `${lang}-index`);
const sections = home?.data.sections as HomeSections | undefined;
const supporting = sections?.hero?.supporting;
const houseIntro = sections?.onewhouse?.intro;
const heading = typeof supporting === "string" ? supporting : null;
const intro = typeof houseIntro === "string" ? houseIntro : null;
// Brand Kit v5: one phrase of a display heading may be set in the serif
// italic. The words are the authored line; this only marks which of them
// lean. Chinese has no italic, so those locales stay upright.
const EMPHASIS: Partial<Record<Language, string>> = {
  en: "perspective",
  vi: "Nhìn cao hơn",
};
const phrase = EMPHASIS[lang];
const at = heading && phrase ? heading.indexOf(phrase) : -1;
const parts =
  heading && phrase && at >= 0
    ? {
        before: heading.slice(0, at),
        em: phrase,
        after: heading.slice(at + phrase.length),
      }
    : null;
const statement = heading && intro ? { heading, intro } : null;
---

{statement ? (
  <section
    class="home-close"
    aria-labelledby="home-close-title"
    data-home-close
  >
    <div class="home-close__art" aria-hidden="true">
      <img
        src="/images/about/founder-elevation.webp"
        alt=""
        width="960"
        height="1200"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container class="home-close__inner">
      <div class="home-close__copy">
        <h2
          id="home-close-title"
          class="type-d2 home-close__title text-balance"
        >
          {parts ? (
            <Fragment>
              {parts.before}
              <em>{parts.em}</em>
              {parts.after}
            </Fragment>
          ) : (
            statement.heading
          )}
        </h2>
        <p class="home-close__lead text-pretty">{statement.intro}</p>
        <nav class="home-close__nav" aria-label={navLabel} data-home-next-steps>
          {actions.map((action) => (
            <ButtonLink variant="on-ink" icon="arrow-right" href={action.href}>
              {action.label}
            </ButtonLink>
          ))}
        </nav>
      </div>
    </Container>
  </section>
) : (
  <nav
    class="border-t border-[var(--border-subtle)] bg-[var(--surface-subtle)]"
    aria-label={navLabel}
    data-home-next-steps
  >
    <Container class="flex flex-col gap-3 py-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="eyebrow">{navLabel}</p>
      <div class="flex flex-wrap gap-3">
        {actions.map((action) => (
          <ButtonLink variant="secondary" icon="arrow-right" href={action.href}>
            {action.label}
          </ButtonLink>
        ))}
      </div>
    </Container>
  </nav>
)}

<style>
  /* Always ink, like the footer it leads into: porcelain text in both themes. */
  .home-close {
    position: relative;
    overflow: hidden;
    background: var(--brand-ink);
    color: var(--brand-porcelain);
    border-top: 1px solid color-mix(in srgb, white 8%, transparent);
  }
  .home-close__art {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(56%, 50rem);
  }
  .home-close__art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
  }
  /* The artwork dissolves into the ink toward the copy and the footer. */
  .home-close__art::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        var(--brand-ink) 0%,
        color-mix(in srgb, var(--brand-ink) 55%, transparent) 38%,
        transparent 75%
      ),
      linear-gradient(to top, var(--brand-ink), transparent 30%);
  }
  .home-close :global(.home-close__inner) {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 26rem;
  }
  .home-close__copy {
    max-width: 36rem;
    padding-block: 4rem;
  }
  .home-close__title {
    margin: 0;
    color: var(--brand-porcelain);
  }
  .home-close__lead {
    margin: 1.25rem 0 2rem;
    font-size: var(--size-4);
    line-height: 1.5;
    color: color-mix(in srgb, var(--brand-porcelain) 80%, transparent);
  }
  .home-close__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 767px) {
    .home-close {
      display: flex;
      flex-direction: column;
    }
    .home-close__art {
      position: relative;
      order: 2;
      width: 100%;
      height: 16rem;
    }
    .home-close__art::after {
      background: linear-gradient(to bottom, var(--brand-ink), transparent 40%);
    }
    .home-close :global(.home-close__inner) {
      min-height: 0;
    }
    .home-close__copy {
      padding-block: 3rem 1.5rem;
    }
  }
  /* Spanned foldables: nothing may sit across the hinge, so the decorative
     artwork steps out and the statement stays in the leading segment. */
  @media (forced-colors: active), (horizontal-viewport-segments: 2) {
    .home-close__art {
      display: none;
    }
  }
  @media print {
    .home-close__art {
      display: none;
    }
  }
</style>
