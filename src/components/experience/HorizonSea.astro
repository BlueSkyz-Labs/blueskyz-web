---
import { labelFor, type Language } from "@/data/site";

/**
 * Horizon Sea: the living layer of the home hero (Owner 2026-11-10).
 *
 * A decorative canvas behind the hero content plus the control that pauses
 * it. Without JS, under reduced motion, forced colours or data saving nothing
 * is drawn and the control stays hidden, so the hero is exactly the static
 * Horizon & Sail composition. The scene itself is `src/scripts/horizon-sea.ts`.
 * The hero section carries `data-horizon-sea-root`.
 */
interface Props {
  lang?: Language;
}
const { lang = "en" } = Astro.props;

const pauseLabel = labelFor(
  {
    en: "Pause background motion",
    vi: "Tạm dừng chuyển động nền",
    zh: "暂停背景动效",
    "zh-hant": "暫停背景動效",
  },
  lang,
);
const playLabel = labelFor(
  {
    en: "Play background motion",
    vi: "Bật chuyển động nền",
    zh: "播放背景动效",
    "zh-hant": "播放背景動效",
  },
  lang,
);
---

<canvas class="horizon-sea" data-horizon-sea aria-hidden="true"></canvas>
<button
  type="button"
  class="horizon-sea-toggle"
  data-horizon-sea-toggle
  data-label-pause={pauseLabel}
  data-label-play={playLabel}
  aria-label={pauseLabel}
  hidden
>
  <svg
    class="horizon-sea-toggle__pause"
    viewBox="0 0 16 16"
    width="14"
    height="14"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M4.5 3v10M11.5 3v10"></path>
  </svg>
  <svg
    class="horizon-sea-toggle__play"
    viewBox="0 0 16 16"
    width="14"
    height="14"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M5 3.2 12.4 8 5 12.8Z"></path>
  </svg>
</button>

<script>
  import { bootHorizonSea } from "@/scripts/horizon-sea";
  bootHorizonSea();
</script>

<style>
  .horizon-sea {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .horizon-sea-toggle {
    position: absolute;
    z-index: 3;
    right: max(0.75rem, calc(var(--site-gutter, 1rem) - 0.75rem));
    bottom: 0.5rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    color: color-mix(in srgb, var(--brand-porcelain) 78%, transparent);
    background: transparent;
  }
  .horizon-sea-toggle[hidden] {
    display: none;
  }
  .horizon-sea-toggle::before {
    content: "";
    position: absolute;
    inset: 0.5rem;
    border: 1px solid
      color-mix(in srgb, var(--brand-porcelain) 30%, transparent);
    border-radius: inherit;
    background: color-mix(in srgb, var(--brand-ink) 55%, transparent);
  }
  .horizon-sea-toggle:hover {
    color: var(--brand-porcelain);
  }
  .horizon-sea-toggle:hover::before {
    border-color: color-mix(in srgb, var(--brand-porcelain) 70%, transparent);
  }
  .horizon-sea-toggle svg {
    position: relative;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .horizon-sea-toggle__play {
    display: none;
  }
  :global([data-horizon-sea-state="paused"]) .horizon-sea-toggle__pause {
    display: none;
  }
  :global([data-horizon-sea-state="paused"]) .horizon-sea-toggle__play {
    display: block;
  }
  /* A display spanned across a hinge keeps the static hero: a full-bleed
     scene would be drawn across the fold. Print never carries the scene. */
  @media (horizontal-viewport-segments: 2), (vertical-viewport-segments: 2) {
    .horizon-sea,
    .horizon-sea-toggle {
      display: none;
    }
  }
  @media print {
    .horizon-sea,
    .horizon-sea-toggle {
      display: none;
    }
  }
</style>
