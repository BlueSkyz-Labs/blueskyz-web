---
import Dateline from "@/components/shared/Dateline.astro";
import type { Language } from "@/lib/i18n";
import { getShowcase } from "@/lib/showcases";

/**
 * Experience v6 S2 — a real capture of the running app, always labelled.
 *
 * The image is one screen already published in the product's showcase record
 * (`src/content/showcases/<slug>.yaml`): alt text, dimensions, capture
 * revision, date and data class all come from that record. The visible label
 * states that it is a capture of the app in development with sample data, so a
 * screen can never appear without saying where it came from. Identity artwork
 * is never routed through this component (and gets no device chrome).
 * Without a recorded showcase/screen the component renders nothing.
 */
interface Props {
  slug: string;
  /** Showcase screen id (`today` phone, `owner-collect` desktop). */
  screen: string;
  lang: Language;
  /** Above-the-fold capture: eager + fetchpriority high. Default lazy. */
  priority?: boolean;
  /** v8: eager (never lazy) but `fetchpriority="low"` so the H1 text paints first. */
  lowPriority?: boolean;
  /** v8: false drops the visible label when a sibling capture already carries it (deck hom-11). */
  showLabel?: boolean;
  /** CSS `sizes` for the rendered width. */
  sizes: string;
  /**
   * Optional smaller derivative of the same capture (`url width`), offered as
   * a `srcset` candidate so a small slot never downloads the full-size file
   * ahead of the LCP text's font. Same pixels, only resized; `src` stays the
   * recorded showcase asset.
   */
  smallSrc?:
    | { src: string; width: number }
    | { src: string; width: number }[]
    | undefined;
  /**
   * UX P2-9: optional crop window in source pixels. The same recorded file is
   * shown, enlarged and clipped to this region so its text stays readable in a
   * small slot; nothing is redrawn and the alt/provenance stay the record's.
   */
  crop?: { x: number; y: number; width: number; height: number } | undefined;
  /** The product is public under a new name; the capture still shows the old one. */
  renamed?: boolean;
  class?: string;
}

const {
  slug,
  screen,
  lang,
  priority = false,
  lowPriority = false,
  showLabel = true,
  sizes,
  smallSrc,
  crop,
  renamed = false,
  class: className = "",
} = Astro.props;

const showcase = await getShowcase(slug);
const item = showcase?.data.screens.find(
  (entry: { id: string }) => entry.id === screen,
);
const capture = showcase?.data.capture;
if (!item || !capture) {
  return null;
}
const smallCandidates = smallSrc
  ? (Array.isArray(smallSrc) ? smallSrc : [smallSrc]).map(
      (entry) => `${entry.src} ${entry.width}w`,
    )
  : [];
const pct = (n: number) => `${Math.round(n * 10000) / 100}%`;
const cropStyle = crop
  ? [
      `aspect-ratio: ${crop.width} / ${crop.height}`,
      `--crop-w: ${pct(item.width / crop.width)}`,
      `--crop-x: -${pct(crop.x / crop.width)}`,
      `--crop-y: -${pct(crop.y / crop.height)}`,
    ].join("; ")
  : undefined;
const revision = capture.sourceRevision.slice(0, 7);
const capturedOn = capture.capturedAt.toISOString().slice(0, 10);

const LABEL: Record<Language, string> = {
  en: "Development build · sample data",
  vi: "Bản đang phát triển · dữ liệu mẫu",
  zh: "开发版本 · 示例数据",
  "zh-hant": "開發版本 · 範例資料",
};
// A public product's captures predate its public name: say so (Owner 2026-11-23).
const LABEL_RENAMED: Record<Language, string> = {
  en: "Captured when the product was still named Sổ Trọ · sample data",
  vi: "Ảnh chụp khi sản phẩm còn tên Sổ Trọ · dữ liệu mẫu",
  zh: "截图时产品名为 Sổ Trọ · 示例数据",
  "zh-hant": "截圖時產品名為 Sổ Trọ · 範例資料",
};
const label = (renamed ? LABEL_RENAMED : LABEL)[lang];
---

<figure
  class:list={["flagship-capture", className]}
  data-flagship-capture
  data-capture-surface={item.surface}
  data-capture-revision={revision}
  data-capture-date={capturedOn}
  data-capture-crop={crop ? "" : undefined}
>
  <div
    class:list={[crop ? "flagship-capture__crop" : "flagship-capture__frame"]}
    style={cropStyle}
  >
    <img
      class="flagship-capture__image"
      src={item.src}
      srcset={
        smallCandidates.length > 0
          ? [...smallCandidates, `${item.src} ${item.width}w`].join(", ")
          : undefined
      }
      alt={item.alt[lang]}
      width={item.width}
      height={item.height}
      sizes={sizes}
      decoding="async"
      loading={priority ? "eager" : "lazy"}
      fetchpriority={lowPriority ? "low" : priority ? "high" : "auto"}
      data-capture-src={item.src}
      data-lcp-candidate={priority ? "" : undefined}
    />
  </div>
  {showLabel ? (
    <figcaption class="flagship-capture__label">
      {label}
      <span class="flagship-capture__provenance">
        <Dateline iso={capturedOn} lang={lang} class="dateline--inherit" />
      </span>
    </figcaption>
  ) : null}
</figure>

<style>
  .flagship-capture {
    margin: 0;
    min-width: 0;
  }
  .flagship-capture__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid
      color-mix(in srgb, var(--brand-porcelain) 22%, transparent);
    background: var(--brand-ink);
    opacity: 1;
  }
  /* Without a crop the wrapper is layout-neutral. */
  .flagship-capture__frame {
    display: contents;
  }
  .flagship-capture__crop {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid
      color-mix(in srgb, var(--brand-porcelain) 22%, transparent);
    background: var(--brand-ink);
  }
  .flagship-capture__crop .flagship-capture__image {
    position: absolute;
    left: var(--crop-x);
    top: var(--crop-y);
    width: var(--crop-w);
    max-width: none;
    border: 0;
    border-radius: 0;
  }
  .flagship-capture__label {
    margin-top: 0.5rem;
    font-size: var(--size-1);
    line-height: 1.35;
    color: color-mix(in srgb, var(--brand-porcelain) 82%, transparent);
  }
  .flagship-capture__provenance {
    display: block;
    opacity: 0.85;
    font-variant-numeric: tabular-nums;
  }
</style>
