---
import type { CollectionEntry } from "astro:content";
import { SHARED_LABELS, labelFor, type Language } from "@/data/site";
import { getProductIndexPath } from "@/lib/product-routes";
import {
  getProductIconThumbPath,
  getProductProfilePath,
} from "@/lib/product-routes";
import { productCopy } from "@/lib/product-copy";
import {
  lifecycleCtaAccessibleName,
  resolveLifecycleCta,
} from "@/lib/lifecycle-cta";
import { HOME_ONE_LINER } from "@/data/home-copy";
import type ProductCardComponent from "./ProductCard.astro";
import ProofFirstEmptyState from "./ProofFirstEmptyState.astro";

/**
 * C2 Act II — Product House.
 * Editorial hierarchy over the existing public product collection: one hero,
 * up to two featured, then ecosystem. No second registry, no invented product:
 * hierarchy derives only from `featuredTier` metadata that the record owns.
 * With an empty registry the act renders the repository's honest
 * proof-first statement instead of a fabricated card grid.
 */
interface Props {
  products: CollectionEntry<"products">[];
  lang: Language;
  /** The Flagship Theatre already presents the hero above this section. */
  mode?: "house" | "continuation";
  /** Experience v6 S1: heading + cards only (no body line, no index button). */
  compact?: boolean;
  /** Required unless `compact`: the ProductCard component, injected by the caller. */
  card?: typeof ProductCardComponent;
}

const { products, lang, mode = "house", compact = false, card } = Astro.props;

const flagship = products.find(
  (product) => product.data.featuredTier === "hero",
);
const isContinuation = mode === "continuation" && Boolean(flagship);
const visibleProducts = isContinuation
  ? products.filter((product) => product.data.slug !== flagship?.data.slug)
  : products;

if (isContinuation && visibleProducts.length === 0) {
  return null;
}

const hero = isContinuation ? undefined : flagship;
const featured = visibleProducts
  .filter((product) => product.data.featuredTier === "featured")
  .slice(0, 2);
const ecosystem = visibleProducts.filter(
  (product) => product.data.featuredTier === "ecosystem",
);

const headingLabel = labelFor(
  isContinuation
    ? SHARED_LABELS.continuationHeading
    : SHARED_LABELS.featuredHeading,
  lang,
);
const ctaLabel = labelFor(SHARED_LABELS.exploreAllProducts, lang);
const indexPath = getProductIndexPath(lang);
// v8 W2: on the home the continuation is one full-width horizontal row per
// product: icon, name, badge, one-liner (deck hom-14) and the lifecycle CTA.
// Owner 2026-10-20 (ACQ-10): one primary link per product per section, so the
// name is plain text when the CTA already leads to the same profile URL.
const rows = (compact && isContinuation ? visibleProducts : []).map(
  (product) => {
    const copy = productCopy(product.data, lang);
    const slug = product.data.slug;
    return {
      product,
      statusLabel: copy.statusLabel,
      line: HOME_ONE_LINER[slug]?.[lang] ?? copy.shortDescription,
      href: getProductProfilePath(lang, slug),
      icon: getProductIconThumbPath(slug),
      cta: resolveLifecycleCta(
        {
          slug,
          lifecycle: product.data.lifecycle,
          availability: product.data.availability,
          primaryActionHref: product.data.primaryAction.href,
          productName: product.data.name,
        },
        lang,
      ),
    };
  },
);

// CSS diet (D-06): ProductCard carries its own scoped stylesheet and Astro
// bundles CSS per static or dynamic import, rendered or not. The compact home
// continuation renders `rows` and never mounts a card, so the card component is
// injected by the callers that do render cards instead of being imported here.
// A type-only import is erased at build time and ships no CSS.
const ProductCard = card as typeof ProductCardComponent;
if (!compact && products.length > 0 && !card) {
  throw new Error(
    "ProductHouse: pass `card={ProductCard}` unless `compact` is set.",
  );
}
---

<section
  class:list={[
    // Calm-chrome round (2026-10-04): acts are separated by space, not rules.
    "c2-product-house",
    // Home rhythm (aesthetic S1, MED-2): a continuation directly follows the
    // flagship act, which already carries one full section-y of bottom padding,
    // so its own top padding steps down to the tight token (no 2x section-y).
    isContinuation
      ? "pt-[var(--section-y-tight)] pb-[var(--section-y)]"
      : "section-y",
  ]}
  aria-labelledby="product-house-title"
  data-product-house
>
  <div class="product-act-intro flex flex-wrap items-end justify-between gap-4">
    <div class="product-act-intro__copy">
      <h2
        id="product-house-title"
        class:list={[
          "type-d2",
          "product-act-intro__title",
          // Home hierarchy (aesthetic S5, LOW-2): the continuation is the
          // secondary act, so its heading steps down one scale step (32 -> 24 px)
          // below the flagship's d2; the flagship heading is unchanged.
          isContinuation && compact && "product-act-intro__title--secondary",
        ]}
      >
        {headingLabel}
      </h2>
    </div>
    {products.length > 0 && !compact ? (
      <a
        href={indexPath}
        class="inline-flex min-h-11 items-center rounded-[var(--radius-sm)] border border-[var(--border-subtle)] px-5 py-2.5 font-medium text-[var(--text-primary)] no-underline hover:bg-[var(--bg-subtle)]"
      >
        {ctaLabel}
      </a>
    ) : null}
  </div>

  {products.length === 0 ? (
    <div class="mt-8">
      <ProofFirstEmptyState lang={lang} />
    </div>
  ) : rows.length > 0 ? (
    <div class="mt-6 grid gap-4">
      {rows.map((row) => (
        <article
          class="product-row"
          data-product-card
          data-product-tier={row.product.data.featuredTier}
        >
          <img
            class="product-row__icon"
            src={row.icon}
            alt=""
            width="48"
            height="48"
            loading="lazy"
            decoding="async"
          />
          <div class="product-row__main">
            <h3 class="product-row__name">
              {row.cta.href === row.href ? (
                <span data-product-name>{row.product.data.name}</span>
              ) : (
                <a
                  href={row.href}
                  class="inline-flex min-h-11 items-center text-inherit no-underline hover:underline"
                >
                  {row.product.data.name}
                </a>
              )}
              <span
                data-product-status={row.product.data.publicLabel}
                class="status-badge"
              >
                {row.statusLabel}
              </span>
            </h3>
            <p class="product-row__line">{row.line}</p>
          </div>
          <a
            href={row.cta.href}
            data-product-cta={row.cta.verb}
            aria-label={lifecycleCtaAccessibleName(
              row.cta.label,
              row.product.data.name,
            )}
            class="product-row__cta"
          >
            {row.cta.label}
          </a>
        </article>
      ))}
    </div>
  ) : (
    <div class="mt-10 grid gap-6">
      {hero ? (
        <div class="break-words min-w-0">
          <ProductCard product={hero} lang={lang} emphasis="hero" />
        </div>
      ) : null}
      {featured.length > 0 || ecosystem.length > 0 ? (
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {[...featured, ...ecosystem].map((product) => (
            <div class="break-words min-w-0">
              <ProductCard product={product} lang={lang} />
            </div>
          ))}
        </div>
      ) : null}
    </div>
  )}
</section>

<script>
  // Pointer light for the product rows: records where a fine pointer is
  // inside the row so the hover highlight follows it. Presentation only.
  if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
    for (const row of document.querySelectorAll<HTMLElement>(".product-row")) {
      row.addEventListener(
        "pointermove",
        (event) => {
          const box = row.getBoundingClientRect();
          row.style.setProperty("--spot-x", `${event.clientX - box.left}px`);
          row.style.setProperty("--spot-y", `${event.clientY - box.top}px`);
        },
        { passive: true },
      );
    }
  }
</script>

<style>
  .product-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    min-width: 0;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    background: var(--surface-raised);
  }
  /* A fine pointer lights the row it rests on: the light follows the pointer
     (two custom properties written by the script below) and the row lifts a
     little. Hover only, so touch and keyboard see the plain row. */
  @media (hover: hover) and (pointer: fine) {
    .product-row {
      transition:
        transform var(--motion-quick, 180ms) var(--ease-standard, ease),
        border-color var(--motion-quick, 180ms) var(--ease-standard, ease),
        box-shadow var(--motion-quick, 180ms) var(--ease-standard, ease);
    }
    .product-row:hover {
      transform: translateY(-2px);
      border-color: color-mix(
        in srgb,
        var(--brand-cobalt) 45%,
        var(--border-subtle)
      );
      background:
        radial-gradient(
          24rem circle at var(--spot-x, 50%) var(--spot-y, 50%),
          color-mix(in srgb, var(--brand-cobalt) 9%, transparent),
          transparent 62%
        ),
        var(--surface-raised);
      box-shadow: 0 14px 34px -22px
        color-mix(in srgb, var(--brand-cobalt) 55%, transparent);
    }
  }
  @media (forced-colors: active) {
    .product-row:hover {
      transform: none;
      background: Canvas;
    }
  }
  /* Dark keeps the quieter hairline (LOW-5: only light was near-invisible). */
  :global([data-theme="dark"]) .product-row {
    border-color: var(--border-hairline);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .product-row {
      border-color: var(--border-hairline);
    }
  }
  /* Keeps the d2 face, weight, VI leading and CJK stack; only the size steps
     down. Compound selector so it outranks .type-d2 in any bundle order. */
  .type-d2.product-act-intro__title--secondary {
    font-size: var(--size-6);
  }
  .product-row__main {
    min-width: 0;
  }
  /* Fixed px: at 200% text a 3rem icon took the name column down to about
     one glyph (46px at 320px), so a status word could not fit. The icon is
     not text and does not need to grow with it; 48px equals 3rem at 100%. */
  .product-row__icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-card);
  }
  .product-row__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin: 0;
    font-size: var(--size-5);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .product-row__line {
    margin: 0.25rem 0 0;
    font-size: var(--size-2);
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .product-row__cta {
    grid-column: 1 / -1;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    padding: 0.375rem 1rem;
    font-size: var(--size-2);
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
  }
  .product-row__cta:hover {
    border-color: var(--action-primary);
  }
  @media (min-width: 768px) {
    .product-row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      padding: 1.25rem 1.5rem;
    }
    .product-row__cta {
      grid-column: auto;
    }
  }
</style>
