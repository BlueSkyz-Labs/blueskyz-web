---
import { formatDate, type Language } from "@/lib/i18n";
import type { ShowcaseSchema } from "@/lib/showcase-schema";
import ShowcaseGroup from "@/components/product/ShowcaseGroup.astro";
import FeatureStory from "@/components/product/FeatureStory.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import {
  STORY_COPY,
  isLandlordStory,
  storyFrame,
} from "@/components/product/story-copy";
import { resolveFeatureStory } from "@/lib/feature-story";
import { getPublicProducts } from "@/lib/products";
import { productCopy } from "@/lib/product-copy";

/**
 * GOLIVE W5 — real screens of a product's running application.
 * Every image is a `ui-screenshot` bound to the capture revision and data
 * class in the showcase record; the disclosure line is always rendered, so a
 * screen can never appear without saying where it came from. Motion is pure
 * CSS (scroll-driven where supported) and is disabled for reduced motion; no
 * client script is shipped.
 *
 * Mobile LCP (the hero text above this section) is guarded by Lighthouse, so
 * the section stays off its critical path: styles are inlined instead of a
 * render-blocking stylesheet (CSP allows inline styles, not scripts), and the
 * section skips layout and paint until it nears the viewport.
 */
interface Props {
  showcase: ShowcaseSchema;
  lang: Language;
  productName: string;
}

const { showcase, lang, productName } = Astro.props;
// v12 S1: when the record carries a feature story, the story leads (its
// chapters and coda) and every screen it does not tell sits behind "More
// screens". The story resolves only against this record's screens and the
// product record's jobs and capabilities; anything else fails the build.
const productData = (await getPublicProducts()).find(
  (entry) => entry.data.slug === showcase.product,
)?.data;
const story =
  showcase.story && productData
    ? resolveFeatureStory(
        showcase.story,
        showcase.screens,
        productCopy(productData, lang),
      )
    : null;
const told = new Set(
  story
    ? [
        ...story.chapters.map((chapter) => chapter.screen.id),
        ...(story.coda ? [story.coda.id] : []),
      ]
    : [],
);
const untold = showcase.screens.filter((item) => !told.has(item.id));
const phones = untold.filter((item) => item.surface === "phone");
const desktops = untold.filter((item) => item.surface === "desktop");
// v8 W3 (no story): three phone captures and one desktop capture lead; the
// rest sit behind "More screens" so the page stays a story, not a data sheet.
// With a story, nothing else leads: the story is the lead.
const heroPhones = story ? [] : phones.slice(0, 3);
const heroDesktops = story ? [] : desktops.slice(0, 1);
const morePhones = story ? phones : phones.slice(3);
const moreDesktops = story ? desktops : desktops.slice(1);
const hasMore = morePhones.length + moreDesktops.length > 0;
const capturedIso = showcase.capture.capturedAt.toISOString().slice(0, 10);
const capturedOn = formatDate(lang, capturedIso);

const COPY = {
  en: {
    heading: `See ${productName}’s screens`,
    disclosure: `Screens from the development build. Captured ${capturedOn} with sample data only: no real tenants, payments or personal data.`,
    video: "Quick introduction",
    videoNote:
      "Short silent video. On-screen text is Vietnamese; subtitles in English, Vietnamese and Chinese.",
    phone: "On a family phone",
    phoneRail: "Phone screens — scroll sideways or use the arrow keys",
    desktop: "On the owner’s computer",
    more: "More screens",
    guide: "Read the guide",
  },
  vi: {
    heading: `Xem giao diện ${productName}`,
    disclosure: `Giao diện của bản đang phát triển. Chụp ngày ${capturedOn}, chỉ dùng dữ liệu mẫu: không có người thuê, thanh toán hay dữ liệu cá nhân thật.`,
    video: "Giới thiệu nhanh",
    videoNote:
      "Video ngắn, không tiếng. Chữ trên màn hình là tiếng Việt; có phụ đề tiếng Anh, Việt, Trung.",
    phone: "Trên điện thoại người nhà",
    phoneRail: "Màn hình điện thoại — vuốt ngang hoặc dùng phím mũi tên",
    desktop: "Trên máy tính của chủ trọ",
    more: "Xem thêm màn hình",
    guide: "Đọc hướng dẫn",
  },
  zh: {
    heading: `查看 ${productName} 的实际界面`,
    disclosure: `开发版本的界面。截取于 ${capturedOn}，仅使用示例数据：没有真实租客、付款或个人数据。`,
    video: "快速介绍",
    videoNote: "简短无声视频。画面文字为越南语；提供英、越、中字幕。",
    phone: "家人手机",
    phoneRail: "手机界面——左右滑动或使用方向键",
    desktop: "房东电脑",
    more: "更多界面",
    guide: "阅读入门指南",
  },
  "zh-hant": {
    heading: `看看 ${productName} 的實際畫面`,
    disclosure: `開發版本的畫面。擷取於 ${capturedOn}，僅使用範例資料：沒有真實房客、付款或個人資料。`,
    video: "快速介紹",
    videoNote: "簡短無聲影片。畫面文字為越南語；提供英、越、中字幕。",
    phone: "家人手機",
    phoneRail: "手機介面——左右滑動或使用方向鍵",
    desktop: "房東電腦",
    more: "更多畫面",
    guide: "閱讀入門指南",
  },
} as const satisfies Record<Language, Record<string, string>>;

// The landlord framing (tenants, a family phone, the owner's computer) is Sổ
// Trọ's. Other products keep the same structure with neutral wording.
const NEUTRAL_COPY = {
  en: {
    disclosure: `Screens from the development build. Captured ${capturedOn} with sample data only: no real users or personal data.`,
    phone: "On a phone",
    desktop: "On a computer",
  },
  vi: {
    disclosure: `Giao diện của bản đang phát triển. Chụp ngày ${capturedOn}, chỉ dùng dữ liệu mẫu: không có người dùng hay dữ liệu cá nhân thật.`,
    phone: "Trên điện thoại",
    desktop: "Trên máy tính",
  },
  zh: {
    disclosure: `开发版本的界面。截取于 ${capturedOn}，仅使用示例数据：没有真实用户或个人数据。`,
    phone: "手机端",
    desktop: "电脑端",
  },
  "zh-hant": {
    disclosure: `開發版本的畫面。擷取於 ${capturedOn}，僅使用範例資料：沒有真實使用者或個人資料。`,
    phone: "手機端",
    desktop: "電腦端",
  },
} as const satisfies Record<Language, Record<string, string>>;

const t = isLandlordStory(showcase.product)
  ? COPY[lang]
  : { ...COPY[lang], ...NEUTRAL_COPY[lang] };
const frame = storyFrame(lang, showcase.product);
const heading = story ? frame.title(productName) : t.heading;
const guideHref = showcase.guide
  ? `/${lang}/products/${showcase.product}/guide/`
  : null;
// Vietnamese text is burned into the video, so the Vietnamese page shows no
// subtitles by default; other pages default to their own script, else English.
const PAGE_TRACK: Record<Language, string | null> = {
  en: "en",
  vi: null,
  zh: "zh-Hans",
  "zh-hant": "zh-Hant",
};
const wanted = PAGE_TRACK[lang];
const defaultTrack = wanted
  ? (showcase.video?.captions.find((track) => track.lang === wanted) ??
    showcase.video?.captions.find((track) => track.lang === "en") ??
    null)
  : null;
---

<section
  class="showcase mt-16"
  aria-labelledby="profile-showcase"
  data-product-showcase={showcase.product}
  data-capture-data={showcase.capture.data}
  data-capture-revision={showcase.capture.sourceRevision}
>
  <div class="showcase__header">
    <h2 id="profile-showcase" class="type-d2 text-[var(--text-primary)]">
      {heading}
    </h2>
    {story ? (
      <p class="showcase__lead mt-4 max-w-3xl" data-story-lead>
        {frame.lead}
      </p>
    ) : null}
    <p
      class="mt-3 max-w-3xl text-sm leading-relaxed text-[var(--text-muted)]"
      data-showcase-disclosure
    >
      {t.disclosure}
    </p>
  </div>

  {story ? (
    <FeatureStory story={story} lang={lang} product={showcase.product} />
  ) : null}

  {showcase.video ? (
    <figure
      class:list={["showcase__video view-rise m-0", story ? "mt-20" : "mt-8"]}
    >
      <video
        controls
        playsinline
        muted
        preload="none"
        poster={showcase.video.poster}
        width={showcase.video.width}
        height={showcase.video.height}
        aria-describedby="showcase-video-note"
      >
        {showcase.video.webm ? (
          <source src={showcase.video.webm} type="video/webm" />
        ) : null}
        <source src={showcase.video.src} type="video/mp4" />
        {showcase.video.captions.map((track) => (
          <track
            kind="subtitles"
            src={track.src}
            srclang={track.lang}
            label={track.label}
            default={defaultTrack?.lang === track.lang}
          />
        ))}
      </video>
      <figcaption class="mt-3 text-sm text-[var(--text-muted)]">
        <strong class="font-semibold text-[var(--text-secondary)]">
          {t.video}
        </strong>
        <span id="showcase-video-note"> · {t.videoNote}</span>
      </figcaption>
    </figure>
  ) : null}

  {guideHref ? (
    <p class="showcase__guide mt-6" data-showcase-guide>
      <ButtonLink href={guideHref} variant="secondary" data-showcase-guide-link>
        {t.guide}
      </ButtonLink>
    </p>
  ) : null}

  {heroPhones.length + heroDesktops.length > 0 ? (
    <ShowcaseGroup
      phones={heroPhones}
      desktops={heroDesktops}
      lang={lang}
      labels={{
        ...t,
        inspect: STORY_COPY[lang].inspect,
        inspectOpens: STORY_COPY[lang].inspectOpens,
        viewerClose: STORY_COPY[lang].viewerClose,
      }}
      first
    />
  ) : null}

  {hasMore ? (
    <details class="showcase__more mt-10" data-showcase-more>
      <summary>{t.more}</summary>
      <ShowcaseGroup
        phones={morePhones}
        desktops={moreDesktops}
        lang={lang}
        labels={{
          ...t,
          inspect: STORY_COPY[lang].inspect,
          inspectOpens: STORY_COPY[lang].inspectOpens,
          viewerClose: STORY_COPY[lang].viewerClose,
        }}
      />
    </details>
  ) : null}
</section>

<style is:inline>
  /* Below the fold: skip layout and paint until near the viewport. The
     placeholder heights are the measured section heights with the gallery
     collapsed (Sổ Trọ with its Feature Story, 2026-10-04, reduced motion:
     4431-4660 px at 390, 4554-4572 px at 1024, 4630-4648 px at 1440 across
     the four locales) so the scrollbar does not jump. Where the sticky story
     stage runs, each of the five chapters is 51svh tall (EX-06), so the
     placeholder follows the viewport height (1875 px + 5 x 51svh at 1024,
     1950 px + 5 x 51svh at 1440; static: 4003-4022 px at 1024, 4079-4098 px
     at 1440, 4288-4524 px at 390, all four locales, measured 2026-10-23 with
     the desktop sheet hidden below 40rem, EX-05). Guarded by
     tests/e2e/wp-c-product-surfaces.spec.ts; re-measure after any layout
     change. */
  .showcase {
    content-visibility: auto;
    /* 390px collapsed-gallery height, EX-05 (the 1920px sheet is not drawn
       below 40rem): measured 4288-4524px across the four locales, reduced
       motion; retain the strict 6% CLS guard. */
    contain-intrinsic-size: auto 4450px;
  }
  @media (min-width: 64rem) {
    .showcase {
      contain-intrinsic-size: auto 4030px;
    }
  }
  @media (min-width: 80rem) {
    .showcase {
      contain-intrinsic-size: auto 4100px;
    }
  }
  .showcase__lead {
    font-size: var(--size-5);
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .showcase__label {
    font-size: var(--size-1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Vietnamese: sentence case (cross-subset kerning, see .eyebrow). */
  :lang(vi) .showcase__label {
    text-transform: none;
    letter-spacing: var(--tracking-eyebrow, 0.03em);
  }
  .showcase__video video {
    display: block;
    width: 100%;
    max-width: 64rem;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    border: 1px solid var(--border-subtle);
    background: #0b1020;
    box-shadow: 0 24px 60px -24px
      color-mix(in srgb, var(--brand-cobalt) 35%, transparent);
  }
  .showcase__rail {
    margin: 1.25rem -1rem 0;
    padding: 0.5rem 1rem 1.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72%, 17rem);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1rem;
    overscroll-behavior-x: contain;
    list-style: none;
  }
  .showcase__phone {
    scroll-snap-align: start;
    /* Far-below captures stay out of the first-paint request graph. */
    /* Top padding leaves room for the hover lift under paint containment. */
    content-visibility: auto;
    contain-intrinsic-size: auto 35rem;
    padding-top: 0.5rem;
    margin-top: -0.5rem;
  }
  /* F14: on desktop the phones keep their real-world scale (17rem, the same
     as the rail) on a centred stage instead of stretching to a third of the
     page each. */
  @media (min-width: 64rem) {
    .showcase__rail {
      margin: 1.25rem 0 0;
      padding: 0.5rem 0 0;
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 17rem));
      grid-auto-columns: auto;
      justify-content: center;
      column-gap: 3.5rem;
      row-gap: 2.75rem;
      overflow: visible;
    }
    /* Paint containment clips at the item edge, so the item carries room for
       the device shadow instead of cutting it into a visible slab. */
    .showcase__phone {
      padding-inline: 1.5rem;
      margin-inline: -1.5rem;
    }
  }
  /* A spanning book display below 64rem: the scrolling rail would lay later
     phones across the hinge, so the rail becomes one column inside the
     leading segment (the reading column there, see global.css). */
  @media (horizontal-viewport-segments: 2) and (max-width: 63.99rem) {
    .showcase__rail {
      margin-inline: 0;
      padding-inline: 0;
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: minmax(0, 17rem);
      row-gap: 2.75rem;
      overflow: visible;
      scroll-snap-type: none;
    }
  }
  .showcase__device {
    position: relative;
    border-radius: var(--radius-media);
    padding: 0.5rem;
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--text-primary) 16%, transparent),
      color-mix(in srgb, var(--text-primary) 6%, transparent)
    );
    border: 1px solid var(--border-subtle);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 30%, transparent) inset,
      0 28px 48px -28px color-mix(in srgb, #0b1020 55%, transparent);
    transition:
      transform 320ms var(--brand-ease-standard, ease),
      box-shadow 320ms var(--brand-ease-standard, ease);
  }
  .showcase__device img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-media);
  }
  .showcase__phone:hover .showcase__device {
    transform: translateY(-6px);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 30%, transparent) inset,
      0 36px 60px -28px color-mix(in srgb, var(--brand-cobalt) 40%, transparent);
  }
  .showcase__inspect {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    /* Meta voice (colour, size, weight, underline): shared G-05 rule in
       c4-quiet-authority.css. */
  }
  .showcase__inspect:focus-visible {
    outline: 2px solid var(--brand-cobalt);
    outline-offset: 3px;
  }
  .showcase__caption {
    margin-top: 1rem;
    font-size: var(--size-2);
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .showcase__desktops {
    margin-top: 1.25rem;
    display: grid;
    gap: 2rem;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 48rem) {
    .showcase__desktops {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .showcase__desktops > li:first-child {
      grid-column: 1 / -1;
    }
  }
  .showcase__browser {
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid var(--border-subtle);
    background: var(--surface-raised);
    box-shadow: 0 24px 48px -28px color-mix(in srgb, #0b1020 50%, transparent);
    transition: transform 320ms var(--brand-ease-standard, ease);
  }
  .showcase__browser:hover {
    transform: translateY(-4px);
  }
  .showcase__browser-bar {
    display: flex;
    gap: 0.375rem;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .showcase__browser-bar i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--text-primary) 22%, transparent);
  }
  .showcase__browser img {
    display: block;
    width: 100%;
    height: auto;
  }
  .showcase__more > summary {
    display: inline-flex;
    min-height: 2.75rem;
    cursor: pointer;
    align-items: center;
    font-size: var(--size-2);
    font-weight: 600;
    color: var(--action-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .showcase__more > summary:focus-visible {
    outline: 2px solid var(--brand-cobalt);
    outline-offset: 3px;
  }
  .showcase__rail:focus-visible {
    outline: 2px solid var(--brand-cobalt);
    outline-offset: 3px;
  }

  /* W2 "Device stage" (Tier A, CSS only). Where scroll-driven animations
     exist and the visitor allows motion, the three lead phones enter as one
     stacked hand (the outer two tucked behind the centre phone, tilted) and
     fan out to the final row as the stage scrolls in; captions fade in once
     the fan has opened, so stacked captions never overlap. The owner's
     desktop capture rises after them. Keyframes are the shared grammar
     (`stage-fan` / `stage-caption` in reveal.css, `view-rise` in global.css;
     route-local keyframes are banned by c3-craft-contract.test.mjs), so only
     the per-phone offsets and timing live here. The CSS default (no support,
     reduced motion, forced colors, print, no JS) is the final layout. */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .showcase__rail--stage > .showcase__phone {
        animation: stage-fan linear both;
        animation-timeline: var(--view-timeline);
        animation-range: entry 15% cover 42%;
      }
      /* Centre phone on top of the hand; outer phones offset by most of one
         column (17rem + 3.5rem gap) so they peek out from behind it. */
      .showcase__rail--stage > .showcase__phone:nth-child(2) {
        position: relative;
        z-index: 1;
      }
      .showcase__rail--stage > .showcase__phone:nth-child(1) {
        --stack-x: 15.5rem;
        --stack-r: -7deg;
      }
      .showcase__rail--stage > .showcase__phone:nth-child(3) {
        --stack-x: -15.5rem;
        --stack-r: 7deg;
      }
      .showcase__rail--stage > .showcase__phone .showcase__caption {
        animation: stage-caption linear both;
        animation-timeline: var(--view-timeline);
        animation-range: cover 30% cover 46%;
      }
      .showcase__desktops--stage > li:first-child {
        animation: view-rise linear both;
        animation-timeline: var(--view-timeline);
        animation-range: entry 0% cover 30%;
      }
    }
  }
  @media (forced-colors: active) {
    .showcase__rail--stage > .showcase__phone,
    .showcase__rail--stage > .showcase__phone .showcase__caption,
    .showcase__desktops--stage > li:first-child {
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase__device,
    .showcase__browser {
      transition: none;
    }
    .showcase__phone:hover .showcase__device,
    .showcase__browser:hover {
      transform: none;
    }
  }
  /* Placeholder where the sticky story stage runs (see the measured sizes
     at the top of this style). Kept after the device stage block. */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (timeline-scope: --story) {
      .showcase:has([data-feature-story]) {
        contain-intrinsic-size: auto calc(1875px + 255svh);
      }
    }
  }
  @media (min-width: 80rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (timeline-scope: --story) {
      .showcase:has([data-feature-story]) {
        contain-intrinsic-size: auto calc(1950px + 255svh);
      }
    }
  }
</style>
