---
import type { Language } from "@/lib/i18n";
import type { ShowcaseSchema } from "@/lib/showcase-schema";

/**
 * One block of captures: a phone rail followed by desktop captures. Used for
 * the hero captures and again inside the "More screens" disclosure; the
 * styles live in ProductShowcase (inline, global).
 */
type Screen = ShowcaseSchema["screens"][number];
interface Props {
  phones: Screen[];
  desktops: Screen[];
  lang: Language;
  labels: {
    phone: string;
    phoneRail: string;
    desktop: string;
    inspect: string;
    inspectOpens: string;
    viewerClose: string;
  };
  first?: boolean;
}

const { phones, desktops, lang, labels, first = false } = Astro.props;

// Phone captures render at most 17rem, in the rail and in the centred desktop
// stage alike, so phones get the 480w derivative next to each master
// (`<name>-480.webp`). Without it the 780px masters compete with the LCP
// text's fonts.
const PHONE_SIZES = "(min-width: 64rem) 17rem, min(72vw, 17rem)";
// The rail scrolls only below 64rem, where keyboard users need to focus it.
// At >= 64rem it is a plain grid, so the script below removes the dead tab
// stop there (a11y 2026-10-08): tabindex="0" only while the rail scrolls.
const phoneSmallSrc = (src: string) => src.replace(/\.webp$/, "-480.webp");
// Desktop captures are 1920px masters. Each ships a 768w derivative
// (`<name>-768.webp`) so a phone never downloads the full master: the first
// capture spans the grid, the rest take half of it from 48rem up.
const DESKTOP_SIZES_FULL = "(min-width: 64rem) 60rem, calc(100vw - 2.5rem)";
const DESKTOP_SIZES_HALF =
  "(min-width: 64rem) 29rem, (min-width: 48rem) calc(50vw - 2.25rem), calc(100vw - 2.5rem)";
const desktopSmallSrc = (src: string) => src.replace(/\.webp$/, "-768.webp");
---

{phones.length > 0 ? (
  <div class:list={[first ? "mt-10" : "mt-8"]}>
    <h3 class="showcase__label">{labels.phone}</h3>
    <ul
      class:list={["showcase__rail", first && "showcase__rail--stage"]}
      role="list"
      tabindex="0"
      data-showcase-rail
      aria-label={labels.phoneRail}
    >
      {phones.map((item, index) => (
        <li
          class="showcase__phone view-rise view-rise--text"
          style={`--i:${index}`}
        >
          <figure class="m-0">
            <div class="showcase__device">
              <img
                src={item.src}
                srcset={`${phoneSmallSrc(item.src)} 480w, ${item.src} ${item.width}w`}
                sizes={PHONE_SIZES}
                alt={item.alt[lang]}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="showcase__caption">
              <strong class="font-semibold text-[var(--text-primary)]">
                {item.title[lang]}
              </strong>
              <span> — {item.caption[lang]}</span>
              <a
                href={item.src}
                class="showcase__inspect"
                aria-label={`${labels.inspect}: ${item.title[lang]} (${labels.inspectOpens})`}
                target="_blank"
                rel="noopener noreferrer"
                data-capture-inspect
                data-viewer-label={`${labels.inspect}: ${item.title[lang]}`}
                data-viewer-title={item.title[lang]}
                data-viewer-alt={item.alt[lang]}
                data-viewer-close={labels.viewerClose}
              >
                {labels.inspect}
                <span aria-hidden="true">↗</span>
              </a>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
) : null}

{desktops.length > 0 ? (
  <div class="mt-12">
    <h3 class="showcase__label">{labels.desktop}</h3>
    <ul
      class:list={["showcase__desktops", first && "showcase__desktops--stage"]}
      role="list"
    >
      {desktops.map((item, index) => (
        <li class="view-rise view-rise--text">
          <figure class="m-0">
            <div class="showcase__browser">
              <span class="showcase__browser-bar" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
              <img
                src={item.src}
                srcset={`${desktopSmallSrc(item.src)} 768w, ${item.src} ${item.width}w`}
                sizes={index === 0 ? DESKTOP_SIZES_FULL : DESKTOP_SIZES_HALF}
                alt={item.alt[lang]}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="showcase__caption">
              <strong class="font-semibold text-[var(--text-primary)]">
                {item.title[lang]}
              </strong>
              <span> — {item.caption[lang]}</span>
              <a
                href={item.src}
                class="showcase__inspect"
                aria-label={`${labels.inspect}: ${item.title[lang]} (${labels.inspectOpens})`}
                target="_blank"
                rel="noopener noreferrer"
                data-capture-inspect
                data-viewer-label={`${labels.inspect}: ${item.title[lang]}`}
                data-viewer-title={item.title[lang]}
                data-viewer-alt={item.alt[lang]}
                data-viewer-close={labels.viewerClose}
              >
                {labels.inspect}
                <span aria-hidden="true">↗</span>
              </a>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
) : null}

<script>
  // a11y 2026-10-08: the phone rail is a tab stop only while it scrolls
  // (below 64rem). At desktop widths it is a plain grid; remove the dead stop.
  // `matchMedia` mirrors the CSS breakpoint — no layout measurement needed.
  // A spanning book display stacks the rail (ProductShowcase.astro), so it
  // does not scroll there either.
  const mq = window.matchMedia("(max-width: 63.99rem)");
  const spanning = window.matchMedia("(horizontal-viewport-segments: 2)");
  const syncRailTabindex = () => {
    const scrolls = mq.matches && !spanning.matches;
    for (const rail of document.querySelectorAll("[data-showcase-rail]")) {
      rail.setAttribute("tabindex", scrolls ? "0" : "-1");
    }
  };
  syncRailTabindex();
  mq.addEventListener("change", syncRailTabindex);
  spanning.addEventListener("change", syncRailTabindex);
</script>

<script>
  import "@/scripts/capture-viewer";
</script>
