---
import HorizonField from "@/components/experience/HorizonField.astro";
import HorizonSeam from "@/components/experience/HorizonSeam.astro";
import HorizonSea from "@/components/experience/HorizonSea.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import SailReveal from "@/components/motion/SailReveal.astro";
import { SHARED_LABELS, SITE, labelFor, type Language } from "@/data/site";
import { HOME_ONE_LINER, HOME_PRODUCT_LINE } from "@/data/home-copy";
import { emptyRegistryPrimaryCta, emptyRegistrySecondaryCta } from "@/lib/act";
import {
  lifecycleCtaAccessibleName,
  resolveLifecycleCta,
} from "@/lib/lifecycle-cta";
import { productCopy } from "@/lib/product-copy";
import { webPreviewOpen } from "@/components/product/product-page-copy";
import {
  getProductIconThumbPath,
  getProductProfilePath,
} from "@/lib/product-routes";
import { getPublicProducts } from "@/lib/products";
import FlagshipCapture from "@/components/product/FlagshipCapture.astro";

/**
 * Experience v6 S2 — brand + flagship hero (Owner 2026-10-01).
 *
 * The H1 is BlueSkyz's one-line promise, the existing localized
 * `SITE.proposition`. Immediately below it the flagship is presented with a
 * real, labelled capture of the app (`FlagshipCapture`, from the product's
 * showcase record), its name and status chip, its registry one-line
 * description (`productCopy`) and the one primary action, which is
 * `resolveLifecycleCta` (no authored verb). With no public flagship the hero
 * falls back to the company tagline and the honest empty-registry Act path, so
 * nothing is invented.
 */
interface Props {
  lang?: Language;
}
const { lang = "en" } = Astro.props;

const products = await getPublicProducts();
const flagship =
  products.find((product) => product.data.featuredTier === "hero") ?? null;
const copy = flagship ? productCopy(flagship.data, lang) : null;
const cta = flagship
  ? resolveLifecycleCta(
      {
        slug: flagship.data.slug,
        lifecycle: flagship.data.lifecycle,
        availability: flagship.data.availability,
        primaryActionHref: flagship.data.primaryAction.href,
        productName: flagship.data.name,
      },
      lang,
    )
  : null;

// Company-level fallback (no public flagship): tagline once, no slogan stack.
const taglineLead = labelFor(
  {
    en: SITE.taglineLead,
    vi: "Trí tuệ. Tầm nhìn.",
    zh: "智能。提升。",
    "zh-hant": "智慧。提升。",
  },
  lang,
);
const taglineAccent = labelFor(
  {
    en: SITE.taglineAccent,
    vi: "Tác động.",
    zh: "影响。",
    "zh-hant": "影響。",
  },
  lang,
);
const proposition = labelFor(
  {
    en: SITE.proposition,
    vi: "Chúng tôi làm những sản phẩm thông minh, giúp mọi người làm việc nhẹ nhàng và hiệu quả hơn.",
    zh: "我们打造智能化产品，赋能个人并提升工作方式。",
    "zh-hant": "我們打造智慧化產品，賦能個人並提升工作方式。",
  },
  lang,
);
// Product line under the H1 (hom-2, verbatim from the copy deck), each name
// linking to its profile. Preview 2026-10-15: the line states Sổ Trọ is in
// preview and Sổ Tâm in development, so it renders only while the registry
// agrees; otherwise it is dropped rather than left stating a stale state.
const lineFirst = products.find((product) => product.data.slug === "sotro");
const lineSecond = products.find((product) => product.data.slug === "sotam");
const productLine =
  flagship &&
  lineFirst &&
  lineSecond &&
  webPreviewOpen(lineFirst.data) &&
  !webPreviewOpen(lineSecond.data)
    ? HOME_PRODUCT_LINE[lang]
    : null;
const flagshipLine =
  (flagship ? HOME_ONE_LINER[flagship.data.slug]?.[lang] : undefined) ??
  copy?.shortDescription ??
  "";
const publicContactEmail = SITE.contactEmail || SITE.supportEmail;
const emptyPrimary = emptyRegistryPrimaryCta(publicContactEmail, lang);
const emptySecondary = emptyRegistrySecondaryCta(publicContactEmail, lang);
// Flagship present: the proposition is the H1 and carries the promise alone.
// Fallback: tagline H1 plus the proposition as the one supporting sentence.
const supportingLine = flagship ? null : proposition;
---

<section
  class="hero-plane hero-plane--ink relative isolate overflow-hidden border-b border-white/10"
  aria-labelledby="hero-title"
  data-horizon-sea-root
>
  <div class="hero-atmosphere hero-atmosphere--ink" aria-hidden="true"></div>
  <!-- The living layer: a canvas under the content (enhancement only; empty
       without JS or when motion is not welcome) and its pause control. -->
  <HorizonSea lang={lang} />
  <!-- Plain container, not the rise wrapper: the LCP headline lives inside it and must
       not animate or move, so no ancestor may carry the 400 ms rise either. -->
  <div
    class="site-container relative grid hero-grid py-10 sm:py-14 lg:py-12"
    data-hero-layout={flagship && cta ? "flagship" : "company"}
  >
    <div class="hero-content" data-hero>
      <h1
        id="hero-title"
        class:list={[
          "hero-headline text-[var(--brand-porcelain)] font-semibold tracking-tight",
          flagship
            ? "hero-headline--promise max-w-[24ch] text-balance sm:max-w-[32ch] md:max-w-none"
            : "mt-2 max-w-[11ch] text-4xl sm:text-5xl lg:text-7xl",
        ]}
      >
        {flagship ? (
          proposition
        ) : (
          <>
            <span class="block">{taglineLead}</span>
            <span class="mt-1 block text-[var(--brand-cobalt)]">
              {taglineAccent}
            </span>
          </>
        )}
      </h1>
      {supportingLine ? (
        <p class="hero-tagline mt-5 max-w-xl text-lg leading-relaxed text-[color-mix(in_srgb,var(--brand-porcelain)_82%,transparent)]">
          {supportingLine}
        </p>
      ) : null}
      {productLine && lineFirst && lineSecond ? (
        <p
          class="hero-product-line hero-tagline mt-4 max-w-xl text-base text-[color-mix(in_srgb,var(--brand-porcelain)_82%,transparent)]"
          data-hero-product-line
        >
          <span class="whitespace-pre-wrap">{productLine.lead}</span>
          <span class="hero-product-name" data-hero-product-name>
            {lineFirst.data.name}
          </span>
          <span class="whitespace-pre-wrap">{productLine.a}</span>
          <span class="hero-product-name" data-hero-product-name>
            {lineSecond.data.name}
          </span>
          <span class="whitespace-pre-wrap">{productLine.b}</span>
        </p>
      ) : null}
      {productLine && lineSecond && !(flagship && cta) ? (
        <a
          href={getProductProfilePath(lang, lineSecond.data.slug)}
          class="hero-entry-chip mt-3"
          data-hero-entry={lineSecond.data.slug}
        >
          <img
            class="size-7 rounded-md"
            src={getProductIconThumbPath(lineSecond.data.slug)}
            alt=""
            width="28"
            height="28"
            decoding="async"
            loading="lazy"
          />
          <span class="hero-entry-chip__name">{lineSecond.data.name}</span>
          <span class="hero-entry-chip__action">
            {labelFor(SHARED_LABELS.viewProfile, lang)}
          </span>
        </a>
      ) : null}
      {!(flagship && cta) ? (
        <div class="hero-actions mt-6">
          <ButtonLink href={emptyPrimary.href} data-hero-primary>
            {emptyPrimary.label}
          </ButtonLink>
          <a
            href={emptySecondary.href}
            data-hero-secondary
            class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--brand-porcelain)] underline underline-offset-4 hover:no-underline"
          >
            {emptySecondary.label}
          </a>
        </div>
      ) : null}
    </div>
    <!-- F4: in DOM order the flagship name and its one action come before the
         capture, so on a phone they sit under the H1 inside the first screen.
         The wrapper is `display: contents`; the grid places body and stage, so
         reading order and visual order agree at every width (no CSS order). -->
    {flagship && cta ? (
      <div class="hero-flagship" data-hero-flagship>
        <div class="hero-flagship__body">
          <p class="hero-product flex flex-wrap items-center gap-x-3 gap-y-2">
            <img
              class="size-9 rounded-lg"
              src={getProductIconThumbPath(flagship.data.slug)}
              alt=""
              width="36"
              height="36"
              decoding="async"
            />
            <span class="text-lg font-semibold text-[var(--brand-porcelain)]">
              {flagship.data.name}
            </span>
            <span
              data-product-status={flagship.data.publicLabel}
              class="status-badge status-badge--ink"
            >
              {copy?.statusLabel}
            </span>
          </p>
          <p class="hero-tagline mt-2 max-w-md text-sm leading-relaxed text-[color-mix(in_srgb,var(--brand-porcelain)_82%,transparent)]">
            {flagshipLine}
          </p>
          <ButtonLink
            href={cta.href}
            data-product-cta={cta.verb}
            data-hero-primary
            class="hero-flagship__cta mt-4"
            aria-label={lifecycleCtaAccessibleName(
              cta.label,
              flagship.data.name,
            )}
          >
            {cta.label}
          </ButtonLink>
          {productLine && lineSecond ? (
            <a
              href={getProductProfilePath(lang, lineSecond.data.slug)}
              class="hero-entry-chip mt-3"
              data-hero-entry={lineSecond.data.slug}
            >
              <img
                class="size-7 rounded-md"
                src={getProductIconThumbPath(lineSecond.data.slug)}
                alt=""
                width="28"
                height="28"
                decoding="async"
                loading="lazy"
              />
              <span class="hero-entry-chip__name">{lineSecond.data.name}</span>
              <span class="hero-entry-chip__action">
                {labelFor(SHARED_LABELS.viewProfile, lang)}
              </span>
            </a>
          ) : null}
        </div>
        <div class="hero-stage">
          <!-- W1 "Horizon & Sail": the prismatic mark rises behind the capture
               like a sun on the horizon; decorative, desktop only. -->
          <div class="hero-visual" aria-hidden="true">
            <picture>
              <source
                type="image/avif"
                media="(min-width: 1024px)"
                srcset="/brand/blueskyz/v4/hero/prismatic-r4d-mark-560.avif 560w, /brand/blueskyz/v4/hero/prismatic-r4d-mark-840.avif 840w"
                sizes="24rem"
              />
              <source
                type="image/webp"
                media="(min-width: 1024px)"
                srcset="/brand/blueskyz/v4/hero/prismatic-r4d-mark-560.webp 560w, /brand/blueskyz/v4/hero/prismatic-r4d-mark-840.webp 840w"
                sizes="24rem"
              />
              <img
                class="hero-mark"
                src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                alt=""
                width="560"
                height="560"
                decoding="async"
                fetchpriority="low"
              />
            </picture>
            <SailReveal handoff />
          </div>
          <span class="hero-stage__horizon" aria-hidden="true"></span>
          <div class="hero-focal" data-hero-focal>
            <FlagshipCapture
              slug={flagship.data.slug}
              screen="today"
              lang={lang}
              priority
              lowPriority
              sizes="(min-width: 1024px) 18rem, (min-width: 768px) 17.5rem, 13.75rem"
              smallSrc={
                flagship.data.slug === "sotro"
                  ? [
                      {
                        src: "/products/sotro/showcase/op-01-home-288.webp",
                        width: 288,
                      },
                      {
                        src: "/products/sotro/showcase/op-01-home-480.webp",
                        width: 480,
                      },
                    ]
                  : undefined
              }
              class="hero-flagship__capture"
            />
          </div>
        </div>
      </div>
    ) : null}
  </div>
  <!-- VA-01 (throttled re-check): the field is bottom-anchored to the hero, so
       it comes after the hero content in source order. Earlier in the source,
       a progressive first paint placed it against a half-parsed, shorter hero
       and it then jumped down (CLS 0.28 on /vi/ at 390 px, Slow 4G, 4x CPU).
       Paint order is unchanged: .horizon-container keeps z-index 1, under
       .hero-content and the capture (z-index 2). -->
  <div class="horizon-container">
    <div class="horizon-signature">
      <HorizonField />
    </div>
  </div>
  <!-- The hero's bottom edge is an intentional horizon line, not a hard cut.
       Static, decorative, no JS; out of flow so the layout never shifts. -->
  <HorizonSeam class="hero-plane__seam" />
</section>

<style>
  .hero-plane :global(.hero-plane__seam) {
    position: absolute;
    inset-inline: 0;
    bottom: calc(-1.5rem + 1px);
    z-index: 0;
  }
  @media (max-width: 767px) {
    .hero-plane :global(.hero-plane__seam) {
      bottom: calc(-1rem + 1px);
    }
  }

  /* ---- Layout -------------------------------------------------------------
     One column on phones in DOM order: promise, product line, flagship name +
     CTA, then the capture. From 768 px the promise and the flagship body share
     the left column and the capture stage spans both rows on the right. */
  .hero-grid {
    grid-template-columns: minmax(0, 1fr);
    row-gap: 2rem;
  }
  .hero-flagship {
    display: contents;
  }
  .hero-flagship__body {
    min-width: 0;
    width: 100%;
  }
  /* Product line: the two names are plain text (Owner 2026-10-20 ACQ-10: one
     primary link per product per section). The tap-sized entries are the CTA
     and the entry chip below the line. */
  .hero-product-line {
    line-height: 1.625;
  }
  /* A product name never splits across lines. */
  .hero-product-name {
    white-space: nowrap;
    font-weight: 600;
    color: var(--brand-porcelain);
  }
  /* UX-U5: a tap-sized secondary entry for the second product, in the same
     ghost-on-ink treatment as the other hero secondary actions. */
  .hero-entry-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0.375rem 0.875rem 0.375rem 0.5rem;
    border: 1px solid
      color-mix(in srgb, var(--brand-porcelain) 32%, transparent);
    border-radius: var(--radius-card);
    color: var(--brand-porcelain);
    text-decoration: none;
    font-size: var(--size-2);
    line-height: 1.2;
  }
  .hero-flagship__body .hero-entry-chip {
    display: flex;
    width: fit-content;
  }
  .hero-entry-chip__name {
    font-weight: 600;
  }
  .hero-entry-chip__action {
    color: color-mix(in srgb, var(--brand-porcelain) 78%, transparent);
  }
  .hero-entry-chip__action::after {
    content: " \2192";
  }
  .hero-entry-chip:hover {
    border-color: var(--brand-porcelain);
  }

  .hero-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    min-width: 0;
  }
  .hero-focal {
    position: relative;
    z-index: 2;
    width: 13.75rem;
    max-width: 100%;
  }
  .hero-flagship :global(.hero-flagship__capture) {
    width: 100%;
  }
  .hero-flagship :global(.flagship-capture__image) {
    /* Reserve the slot before the image arrives (CLS 0); full frame, no crop. */
    aspect-ratio: 780 / 1440;
    object-fit: contain;
  }
  /* EX-15: the recorded phone screen ends mid-sentence, so the capture fades
     out at its floor, the same intentional fade the products page gives its
     card captures, instead of a hard clip. The fade is a mask on the image
     (same pixels, nothing redrawn); forced-colors keeps the plain image. */
  .hero-flagship :global(.flagship-capture__image) {
    -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 58%, transparent 100%);
  }
  /* The CTA is never allowed to break inside a word. Full width on phones. */
  .hero-flagship :global(.hero-flagship__cta) {
    width: 100%;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    text-align: center;
  }
  /* Horizon / Sail W1: give the real product capture the same restrained
     brand horizon on phones as on desktop. The line stays *behind* the image;
     it uses no image/JS/animation, occupies no layout space, and does not touch
     the LCP headline or the screenshot's reserved dimensions. */
  .hero-stage__horizon {
    display: block;
    position: absolute;
    z-index: 1;
    top: 44%;
    left: 0;
    right: 0;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--brand-cobalt) 45%, transparent) 18%,
      color-mix(in srgb, var(--brand-porcelain) 65%, transparent) 50%,
      color-mix(in srgb, var(--brand-cobalt) 45%, transparent) 82%,
      transparent 100%
    );
  }

  /* Horizon / Sail W1, phones: the HorizonField (halo + line + depth) already
     in the hero collapses to a 0 px box because its wrapper has no height, so
     on phones the whole signature was one hairline under the header. Give the
     existing field a real box and seat its horizon line behind the capture, at
     the stage's 44 % mark (the capture stands on it, like the sail on desktop).
     No new media, font, JS, request or motion: the halo breathing is the
     existing no-preference-only rule. Decorative, aria-hidden, no pointer
     events; it never paints over the headline, badge or CTA (z-index 1 under
     .hero-content z-index 2; the capture is z-index 2). The 1 px stage line
     is dropped here because the field line replaces it. */
  @media (max-width: 767px) {
    .hero-plane {
      --hero-pad-b: 2.5rem;
      /* Stage height (capture slot + caption) in rem; the line sits at 44 %
         from its top, so 56 % of it lies below the line. */
      --hero-stage-h: 27.94rem;
      --hero-field-h: 22rem;
      /* Field line = 24 % above the field's bottom (global.css). */
      --hero-field-bottom: calc(
        var(--hero-pad-b) + var(--hero-stage-h) * 0.56 - var(--hero-field-h) *
          0.24
      );
    }
    .hero-plane :global(.horizon-signature) {
      position: absolute;
      inset-inline: 0;
      bottom: var(--hero-field-bottom);
      height: var(--hero-field-h);
      opacity: 1;
    }
    /* The ink depth fade reads as a hard band behind the capture on a phone;
       the hero atmosphere already supplies the ground. */
    .hero-plane :global(.horizon-signature .horizon-field__depth) {
      display: none;
    }
    /* EX-23: the halo used to stop at the horizon line with its brightest row,
       a hard edge across the phone. It is now centred on the line and fades to
       nothing at its own top and bottom, and the field is tall enough to hold
       the whole glow, so no edge cuts the capture. */
    .hero-plane :global(.horizon-signature .horizon-field__halo) {
      inset: auto -30% calc(24% - 7rem) -30%;
      height: 14rem;
      background: radial-gradient(
        ellipse 50% 50% at 50% 50%,
        color-mix(in srgb, var(--brand-cobalt) 26%, transparent) 0%,
        color-mix(in srgb, var(--brand-cobalt) 10%, transparent) 44%,
        transparent 100%
      );
    }
    .hero-stage__horizon {
      display: none;
    }
  }
  @media (min-width: 640px) and (max-width: 767px) {
    .hero-plane {
      --hero-pad-b: 3.5rem;
    }
  }

  @media (min-width: 768px) {
    .hero-grid[data-hero-layout="flagship"] {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      grid-template-areas:
        "copy stage"
        "body stage";
      /* The stage spans both rows; its extra height is shared by the two rows,
         so the promise (bottom of row 1) and the body (top of row 2) stay a
         centred group beside the capture. */
      grid-template-rows: auto auto;
      column-gap: 2.5rem;
      row-gap: 1.75rem;
      align-items: start;
    }
    .hero-grid[data-hero-layout="flagship"] > .hero-content {
      grid-area: copy;
      align-self: end;
    }
    .hero-flagship__body {
      grid-area: body;
    }
    .hero-stage {
      grid-area: stage;
      align-self: center;
    }
    .hero-focal {
      width: 17.5rem;
    }
    .hero-flagship :global(.hero-flagship__cta) {
      width: auto;
    }
    /* Restrained 3D: the capture turns a few degrees toward the promise. A
       static transform (no layout box change, CLS 0); the slot stays reserved. */
    .hero-focal {
      /* The two custom properties are the pointer response written by the
         Horizon Sea script; both rest at 0, so the static pose is unchanged. */
      transform: perspective(2000px)
        rotateY(calc(-8deg + var(--hero-tilt-y, 0deg)))
        rotateX(var(--hero-tilt-x, 0deg));
      transform-origin: 60% 50%;
    }
    .hero-flagship :global(.flagship-capture__image) {
      /* The outer shadow layers sit outside the masked box, so they are gone
         with the fade (EX-15); the specular top edge stays. */
      box-shadow: 0 1px 0 0
        color-mix(in srgb, var(--brand-porcelain) 30%, transparent) inset;
    }
  }

  /* ---- W1 Horizon & Sail (desktop) ----------------------------------------
     The mark sits up and to the right of the capture so its whole silhouette
     reads, and it rises out of a cobalt horizon line like a sun: the lower edge
     fades into the line instead of being cut by the capture. */
  .hero-stage :global(.hero-visual) {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    /* The Horizon Sea script bobs the sail with the swell (transform only). */
    transform-origin: 30% 88%;
  }
  @media (min-width: 1024px) {
    /* 18rem so the tilted capture still renders >= 280 px wide. */
    .hero-focal {
      justify-self: start;
      width: 18rem;
      margin-inline-start: 6%;
    }
    .hero-stage :global(.hero-visual) {
      top: -1.5rem;
      right: -3rem;
      width: 24rem;
      opacity: 0.92;
      /* The sail stands on the horizon line at 88.5 % of its box. */
      mask-image: linear-gradient(180deg, #000 0 87%, transparent 95%);
    }
    .hero-stage__horizon {
      display: block;
      position: absolute;
      z-index: 1;
      top: calc(-1.5rem + 24rem * 0.885);
      left: -10%;
      right: -6rem;
      height: 1px;
      pointer-events: none;
      background: linear-gradient(
        90deg,
        transparent 0%,
        color-mix(in srgb, var(--brand-cobalt) 70%, transparent) 22%,
        color-mix(in srgb, var(--brand-porcelain) 85%, transparent) 62%,
        color-mix(in srgb, var(--brand-cobalt) 70%, transparent) 86%,
        transparent 100%
      );
      box-shadow: 0 0 18px
        color-mix(in srgb, var(--brand-cobalt) 50%, transparent);
    }
  }

  /* A split book display narrows the left reading segment even though the
     overall viewport still meets the desktop breakpoint. Keep the decorative
     sail and horizon inside that segment instead of drawing across its hinge. */
  @media (horizontal-viewport-segments: 2) {
    .hero-stage :global(.hero-visual) {
      right: 0;
      width: min(
        24rem,
        calc(env(viewport-segment-width 0 0) - 2 * var(--site-gutter))
      );
    }

    .hero-stage__horizon {
      left: 0;
      right: 0;
    }
  }

  @media (forced-colors: active) {
    .hero-flagship :global(.flagship-capture__image) {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero-stage__horizon {
      display: none;
    }
    .hero-focal {
      transform: none;
    }
  }
</style>
