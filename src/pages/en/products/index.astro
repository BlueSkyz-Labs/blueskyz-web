---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import ProductCard from "@/components/product/ProductCard.astro";
import ProofFirstEmptyState from "@/components/product/ProofFirstEmptyState.astro";
import { getPublicProducts } from "@/lib/products";

const products = await getPublicProducts();
const allInDevelopment =
  products.length > 0 &&
  products.every((product) => product.data.lifecycle === "development");
const emptyDescription =
  "Products are published only with verifiable public evidence.";
---

<BaseLayout
  title={PAGE_META["en"].products.title}
  description={
    products.length ? PAGE_META["en"].products.description : emptyDescription
  }
  path="/en/products/"
  scene="product"
>
  <section class="py-16 lg:py-20">
    <Container>
      <PageHeader
        title="Our products"
        lede={
          products.length === 0
            ? "Products appear here when they are ready to evaluate. We publish only what you can verify."
            : allInDevelopment
              ? "Both are in development. Each page states its status."
              : "Each product says plainly what stage it is at, what works now and what is still planned."
        }
      />
      {products.length === 0 ? (
        <div class="mt-12">
          <ProofFirstEmptyState lang="en" />
        </div>
      ) : (
        <section class="mt-12" aria-labelledby="published-products">
          <h2
            id="published-products"
            class:list={[
              "text-xs font-semibold tracking-[0.18em] text-[var(--text-secondary)] uppercase [&:lang(vi)]:normal-case [&:lang(vi)]:tracking-[var(--tracking-eyebrow)]",
              // The cards carry each status badge, so the label stays for screen
              // readers only, whatever the mix of stages.
              "sr-only",
            ]}
          >
            {allInDevelopment ? "In development" : "Products"}
          </h2>
          <div class="product-ledger mt-6 grid gap-x-8 md:grid-cols-2">
            {products.map((product, index) => (
              <ProductCard
                product={product}
                variant="ledger"
                lang="en"
                showThumb
                eager={index < 3}
                priority={index === 0}
              />
            ))}
          </div>
          <p class="mt-10">
            <a
              href="/en/showcase/"
              class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] underline underline-offset-4 hover:no-underline"
            >
              See each app's newest screens
            </a>
          </p>
        </section>
      )}
    </Container>
  </section>
</BaseLayout>
