import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import AboutComposition from "@/components/empty-state/AboutComposition.astro";
---

<BaseLayout
  lastUpdated
  title={PAGE_META["zh-hant"]["about"].title}
  description={PAGE_META["zh-hant"]["about"].description}
  path="/zh-hant/about/"
>
  <AboutComposition lang="zh-hant" part="hero" title="關於 BlueSkyz Labs" />
  <section class="py-12 lg:py-16">
    <Container>
      <AboutComposition lang="zh-hant" part="body" />
    </Container>
  </section>
</BaseLayout>
