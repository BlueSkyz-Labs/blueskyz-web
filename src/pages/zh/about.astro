---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import AboutComposition from "@/components/empty-state/AboutComposition.astro";
---

<BaseLayout
  lastUpdated
  title={PAGE_META["zh"]["about"].title}
  description={PAGE_META["zh"]["about"].description}
  path="/zh/about/"
>
  <AboutComposition lang="zh" part="hero" title="关于 BlueSkyz Labs" />
  <section class="py-12 lg:py-16">
    <Container>
      <AboutComposition lang="zh" part="body" />
    </Container>
  </section>
</BaseLayout>
